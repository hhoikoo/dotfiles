{
  "agentPushNotifEnabled": true,
  "askUserQuestionTimeout": "10m",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoContinueAtUsageLimit": true,
  "awaySummaryEnabled": false,
  "editorMode": "normal",
  "effortLevel": "high",
  "enabledPlugins": {
    "cc-plugin-diff@builtin": false,
    "cc-plugin-telemetry@builtin": false,
    "cc-plugin-you-should-know@builtin": true,
    "slash-menu@hhoikoo": true,
    "work@hhoikoo": true
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "extraKnownMarketplaces": {
    "hhoikoo": {
      "autoUpdate": true,
      "source": {
        "repo": "hhoikoo/agent-marketplace",
        "source": "github"
      }
    }
  },
  "feedbackDrafts": "off",
  "idleCompaction": false,
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "preferredNotifChannel": "auto",
  "promptSuggestionEnabled": false,
  "remoteControlAtStartup": false,
  "skillOverrides": {
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off"
  },
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "sh ~/.claude/statusline-command.sh",
    "type": "command"
  },
  "switchModelsOnFlag": true,
  "theme": "auto",
  "timeFormat": "24-hour",
  "tui": "fullscreen",
  "workflowKeywordTriggerEnabled": false,
  "worktree": {
    "baseRef": "fresh"
  }
}
