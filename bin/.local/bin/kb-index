#!/usr/bin/env bash
# Generate the kb index files from each note's summary field.
# Usage: kb-index [KB_DIR]
#   Writes KB_DIR/INDEX.md (rules, one line per project, one line per active project rule,
#   then other notes while the budget lasts) and KB_DIR/projects/<slug>/INDEX.md (every note of that
#   project). KB_DIR defaults to $KB_DIR or ~/.kb. Portable bash 3.2.
set -eu

KB="${1:-${KB_DIR:-$HOME/.kb}}"
HOST_ENV="${KB_HOST_ENV:-$HOME/.config/dotfiles/host.env}"
MAX_LINES=70
MAX_BYTES=11000
TYPES="rule learning incident reference"

[ -d "$KB" ] || { echo "kb-index: no such directory: $KB" >&2; exit 1; }

# Value of KEY in the host config, without quotes
host_get() {
  [ -f "$HOST_ENV" ] || return 0
  sed -n "s/^$1=//p" "$HOST_ENV" | tail -n 1 | sed -e 's/^["'\'']//' -e 's/["'\'']$//'
}
EXCLUDE=" $(host_get KB_EXCLUDE | tr ',' ' ') "

# Read one note's frontmatter without forking: the first block between the opening and closing ---.
# Flat keys and keys nested under metadata: (the shape the harness writes) both match; the first
# line of a key wins. Sets SUM (summary, else description, else "(no summary)", cut to 160
# characters) and STATUS.
WS=$' \t'
load_note() { # load_note FILE
  local line v n=0 s="" d="" st="" hs=0 hd=0 hst=0
  SUM="(no summary)"
  STATUS=""
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    if [ "$n" = 1 ]; then
      [ "$line" = "---" ] || break
      continue
    fi
    [ "$line" = "---" ] && break
    case "$line" in [$WS]*) line="${line#"${line%%[!$WS]*}"}" ;; esac
    case "$line" in
      summary:*) [ "$hs" = 1 ] && continue; hs=1; v="${line#summary:}" ;;
      description:*) [ "$hd" = 1 ] && continue; hd=1; v="${line#description:}" ;;
      status:*) [ "$hst" = 1 ] && continue; hst=1; v="${line#status:}" ;;
      *) continue ;;
    esac
    v="${v#"${v%%[!$WS]*}"}"
    case "$v" in \"* | \'*) v="${v#?}" ;; esac
    case "$v" in *\" | *\') v="${v%?}" ;; esac
    case "$line" in
      summary:*) s="$v" ;;
      description:*) d="$v" ;;
      *) st="$v" ;;
    esac
    [ "$hs$hd$hst" = 111 ] && break
  done <"$1"
  if [ -n "$s" ]; then SUM="$s"; elif [ -n "$d" ]; then SUM="$d"; fi
  SUM="${SUM:0:160}"
  STATUS="$st"
}

# Set LINES to "- [name](path): summary" for each note of a type under a base folder, joined by
# newlines. With a project slug, active rules are also added to RLINES and counted in RN.
note_lines() { # note_lines BASE TYPE PREFIX [SLUG]
  local f name
  LINES=""
  [ -d "$1/$2" ] || return 0
  for f in "$1/$2"/*.md; do
    [ -f "$f" ] || continue
    name="${f##*/}"
    name="${name%.md}"
    load_note "$f"
    LINES="$LINES${LINES:+
}- [$name]($3$2/$name.md): $SUM"
    if [ -n "${4:-}" ] && [ "$2" = rule ]; then
      case "$STATUS" in stale | superseded | expired) continue ;; esac
      RLINES="$RLINES- [$4/$name](projects/$4/rule/$name.md): ${SUM:0:110}
"
      RN=$((RN + 1))
    fi
  done
}

count_notes() { # count_notes BASE [TYPE...]
  local base="$1" n=0 t f
  shift
  for t in "$@"; do
    [ -d "$base/$t" ] || continue
    for f in "$base/$t"/*.md; do [ -f "$f" ] && n=$((n + 1)); done
  done
  echo "$n"
}

# Write a file only when the content changed, so mtimes stay quiet
put() { # put TMP TARGET
  if [ -f "$2" ] && cmp -s "$1" "$2"; then rm -f "$1"; else chmod 644 "$1"; mv "$1" "$2"; fi
}

tmp="$(mktemp "${TMPDIR:-/tmp}/kb-index.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

# ---- project indexes
projects=""
RLINES=""
RN=0
if [ -d "$KB/projects" ]; then
  for pdir in "$KB"/projects/*/; do
    [ -d "$pdir" ] || continue
    slug="${pdir%/}"
    slug="${slug##*/}"
    case "$EXCLUDE" in *" $slug "*) continue ;; esac
    projects="$projects $slug"
    {
      printf '# Index of project %s\n\n' "$slug"
      [ -f "$pdir/glossary.md" ] && printf 'Terms: [glossary](glossary.md)\n\n'
      for t in $TYPES; do
        note_lines "${pdir%/}" "$t" "" "$slug"
        [ -n "$LINES" ] || continue
        printf '## %s\n\n%s\n\n' "$t" "$LINES"
      done
    } >"$tmp"
    put "$tmp" "$pdir/INDEX.md"
  done
fi

# ---- root index, built under a line and byte budget
root="$(mktemp "${TMPDIR:-/tmp}/kb-index.XXXXXX")"
trap 'rm -f "$tmp" "$root"' EXIT
# The line and byte counts of the root file are tracked here instead of read back with wc
blen() { local LC_ALL=C; BLEN=${#1}; } # byte length of a string, whatever the locale
note_size() { blen "$1"; ROOT_BYTES=$((ROOT_BYTES + BLEN + 1)); ROOT_LINES=$((ROOT_LINES + 1)); }
add() { # add LINE: append while the budget lasts; fail when full
  [ "$ROOT_LINES" -lt "$MAX_LINES" ] && [ "$((ROOT_BYTES + ${#1}))" -lt "$MAX_BYTES" ] || return 1
  printf '%s\n' "$1" >>"$root"
  note_size "$1"
}

ROOT_BYTES=0
ROOT_LINES=0
printf '# Index\n\nRead GUIDE.md first. Notes are <type>/<slug>-<host>.md. Open a note from its line below.\n' >"$root"
note_size "# Index"
note_size ""
note_size "Read GUIDE.md first. Notes are <type>/<slug>-<host>.md. Open a note from its line below."

# Add the lines of one section while the budget lasts; then say how many were left out
section() { # section HEADING TOTAL LINES
  local shown=0 line
  [ "$2" -gt 0 ] || return 0
  add "" || true
  add "## $1" || true
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    add "$line" || break
    shown=$((shown + 1))
  done <<EOF2
$3
EOF2
  # Truncation notes go in past the budget, so a short index still says it is cut
  if [ "$shown" -lt "$2" ]; then
    line="- $((${2} - shown)) more in $1: list the folder"
    printf '%s\n' "$line" >>"$root"
    note_size "$line"
  fi
  return 0
}

note_lines "$KB" rule ""
section "Rules" "$(count_notes "$KB" rule)" "$LINES"

if [ -n "$projects" ]; then
  plines=""
  pn=0
  for slug in $projects; do
    # shellcheck disable=SC2086 # TYPES is a word list
    plines="$plines- [$slug](projects/$slug/INDEX.md): $(count_notes "$KB/projects/$slug" $TYPES) notes
"
    pn=$((pn + 1))
  done
  section "Projects" "$pn" "$plines"
  # One line per active project rule (collected above), so a session sees the rules without opening an index
  section "Project rules" "$RN" "$RLINES"
fi

note_lines "$KB" reference ""
section "References" "$(count_notes "$KB" reference)" "$LINES"
note_lines "$KB" learning ""
section "Learnings" "$(count_notes "$KB" learning)" "$LINES"
note_lines "$KB" incident ""
section "Incidents" "$(count_notes "$KB" incident)" "$LINES"

# INDEX.md is a committed stub that git must ignore once it is generated
if git -C "$KB" ls-files --error-unmatch INDEX.md >/dev/null 2>&1; then
  git -C "$KB" update-index --skip-worktree INDEX.md
fi
put "$root" "$KB/INDEX.md"
if [ ! -e "$KB/MEMORY.md" ] && [ ! -L "$KB/MEMORY.md" ]; then
  ln -s INDEX.md "$KB/MEMORY.md"
fi
