#!/usr/bin/env bash
# Generate the kb index files from each note's summary field.
# Usage: kb-index [KB_DIR]
#   Writes KB_DIR/INDEX.md (rules, one line per project, then other notes while
#   the budget lasts) and KB_DIR/projects/<slug>/INDEX.md (every note of that
#   project). KB_DIR defaults to $KB_DIR or ~/.kb. Portable bash 3.2.
set -eu

KB="${1:-${KB_DIR:-$HOME/.kb}}"
HOST_ENV="${KB_HOST_ENV:-$HOME/.config/dotfiles/host.env}"
MAX_LINES=70
MAX_BYTES=11000
TYPES="rule learning incident reference"

[ -d "$KB" ] || { echo "kb-index: no such directory: $KB" >&2; exit 1; }

# Value of KEY in the host config, without quotes
host_get() {
  [ -f "$HOST_ENV" ] || return 0
  sed -n "s/^$1=//p" "$HOST_ENV" | tail -n 1 | sed -e 's/^["'\'']//' -e 's/["'\'']$//'
}
EXCLUDE=" $(host_get KB_EXCLUDE | tr ',' ' ') "

# Frontmatter field: first block between the opening and closing ---. Flat keys and keys
# nested under metadata: (the shape the harness writes) both match; a top-level key comes first.
fm_get() { # fm_get FILE KEY
  awk -v key="$2" '
    NR == 1 { if ($0 != "---") exit; next }
    $0 == "---" { exit }
    {
      line = $0; sub(/^[ \t]+/, "", line)
      if (index(line, key ":") != 1) next
      v = substr(line, length(key) + 2)
      sub(/^[ \t]+/, "", v); gsub(/^["'\'']|["'\'']$/, "", v)
      print v; exit
    }' "$1"
}

summary_of() {
  local s
  s="$(fm_get "$1" summary)"
  [ -n "$s" ] || s="$(fm_get "$1" description)"
  [ -n "$s" ] || s="(no summary)"
  printf '%s' "$s" | cut -c1-160
}

# Print "- [name](path): summary" for each note of a type under a base folder
note_lines() { # note_lines BASE TYPE PREFIX
  local f name
  [ -d "$1/$2" ] || return 0
  for f in "$1/$2"/*.md; do
    [ -f "$f" ] || continue
    name="$(basename "$f" .md)"
    printf -- '- [%s](%s%s/%s.md): %s\n' "$name" "$3" "$2" "$name" "$(summary_of "$f")"
  done
}

count_notes() { # count_notes BASE [TYPE...]
  local base="$1" n=0 t f
  shift
  for t in "$@"; do
    [ -d "$base/$t" ] || continue
    for f in "$base/$t"/*.md; do [ -f "$f" ] && n=$((n + 1)); done
  done
  echo "$n"
}

# Write a file only when the content changed, so mtimes stay quiet
put() { # put TMP TARGET
  if [ -f "$2" ] && cmp -s "$1" "$2"; then rm -f "$1"; else chmod 644 "$1"; mv "$1" "$2"; fi
}

tmp="$(mktemp "${TMPDIR:-/tmp}/kb-index.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

# ---- project indexes
projects=""
if [ -d "$KB/projects" ]; then
  for pdir in "$KB"/projects/*/; do
    [ -d "$pdir" ] || continue
    slug="$(basename "$pdir")"
    case "$EXCLUDE" in *" $slug "*) continue ;; esac
    projects="$projects $slug"
    {
      printf '# Index of project %s\n\n' "$slug"
      [ -f "$pdir/glossary.md" ] && printf 'Terms: [glossary](glossary.md)\n\n'
      for t in $TYPES; do
        lines="$(note_lines "${pdir%/}" "$t" "")"
        [ -n "$lines" ] || continue
        printf '## %s\n\n%s\n\n' "$t" "$lines"
      done
    } >"$tmp"
    put "$tmp" "$pdir/INDEX.md"
    tmp="$(mktemp "${TMPDIR:-/tmp}/kb-index.XXXXXX")"
  done
fi

# ---- root index, built under a line and byte budget
root="$(mktemp "${TMPDIR:-/tmp}/kb-index.XXXXXX")"
trap 'rm -f "$tmp" "$root"' EXIT
add() { # add LINE: append while the budget lasts; fail when full
  local size
  size="$(wc -c <"$root" | tr -d ' ')"
  [ "$(wc -l <"$root" | tr -d ' ')" -lt "$MAX_LINES" ] && [ "$((size + ${#1}))" -lt "$MAX_BYTES" ] || return 1
  printf '%s\n' "$1" >>"$root"
}

printf '# Index\n\nRead GUIDE.md first. Notes are <type>/<slug>-<host>.md. Open a note from its line below.\n' >"$root"

# Add the lines of one section while the budget lasts; then say how many were left out
section() { # section HEADING TOTAL LINES
  local shown=0 line
  [ "$2" -gt 0 ] || return 0
  add "" || true
  add "## $1" || true
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    add "$line" || break
    shown=$((shown + 1))
  done <<EOF2
$3
EOF2
  # Truncation notes go in past the budget, so a short index still says it is cut
  [ "$shown" -lt "$2" ] && printf -- '- %s more in %s: list the folder\n' "$((${2} - shown))" "$1" >>"$root"
  return 0
}

section "Rules" "$(count_notes "$KB" rule)" "$(note_lines "$KB" rule "")"

if [ -n "$projects" ]; then
  plines=""
  pn=0
  for slug in $projects; do
    # shellcheck disable=SC2086 # TYPES is a word list
    plines="$plines- [$slug](projects/$slug/INDEX.md): $(count_notes "$KB/projects/$slug" $TYPES) notes
"
    pn=$((pn + 1))
  done
  section "Projects" "$pn" "$plines"
fi

section "References" "$(count_notes "$KB" reference)" "$(note_lines "$KB" reference "")"
section "Learnings" "$(count_notes "$KB" learning)" "$(note_lines "$KB" learning "")"
section "Incidents" "$(count_notes "$KB" incident)" "$(note_lines "$KB" incident "")"

# INDEX.md is a committed stub that git must ignore once it is generated
if git -C "$KB" ls-files --error-unmatch INDEX.md >/dev/null 2>&1; then
  git -C "$KB" update-index --skip-worktree INDEX.md
fi
put "$root" "$KB/INDEX.md"
if [ ! -e "$KB/MEMORY.md" ] && [ ! -L "$KB/MEMORY.md" ]; then
  ln -s INDEX.md "$KB/MEMORY.md"
fi
