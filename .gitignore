# Machine-specific git files written by scripts/install.sh
git/.config/git/local
git/.config/git/work
git/.config/git/allowed_signers

.DS_Store

# Claude Code and Codex state
.claude.json
.claude/settings.local.json
claude/.claude/settings.local.json
claude/.claude/projects/
claude/.claude/sessions/
claude/.claude/history.jsonl
claude/.claude/cache/
claude/.claude/backups/
claude/.claude/file-history/
claude/.claude/plugins/
claude/.claude/skills/synced/
claude/.claude/skills/.trash/
codex/.codex/*
!codex/.codex/AGENTS.md

# Per-machine shell and tmux overrides
zsh/.config/zsh/local.zsh
tmux/.config/tmux/local.conf

# Generated by Claude Code beside each mod
claude/.claude/mods/*/node_modules/
claude/.claude/settings.json.bak*
claude/.claude/mods/*/tsconfig.json
