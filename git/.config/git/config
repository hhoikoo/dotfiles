[init]
	defaultBranch = main
[core]
	editor = nvim
	pager = delta-auto
	autocrlf = input
	eol = lf
[color]
	ui = auto
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
[merge]
	conflictStyle = zdiff3
[pull]
	rebase = true
[fetch]
	# Drop remote-tracking branches that no longer exist on the remote
	prune = true
	# Fetch submodules and remotes in parallel, with the job count chosen by git
	parallel = 0
[rebase]
	# Stash and restore uncommitted changes around a rebase
	autoStash = true
[push]
	# The first push of a new branch creates its upstream
	autoSetupRemote = true
# GitHub HTTPS auth through the gh CLI
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
# Git LFS: what `git lfs install` would write here (it would edit this tracked file)
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
# Never guess an identity; it comes from the untracked local file
[user]
	useConfigOnly = true
# Sign commits with SSH keys
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
# Machine-specific identity and signing key (untracked); keep this last
[include]
	path = ~/.config/git/local
