[init]
	defaultBranch = main
[core]
	editor = nvim
	pager = delta-auto
	autocrlf = input
	eol = lf
[color]
	ui = auto
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
[merge]
	conflictStyle = zdiff3
[pull]
	rebase = true
# GitHub HTTPS auth through the gh CLI
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
# Never guess an identity; it comes from the untracked local file
[user]
	useConfigOnly = true
# Sign commits with SSH keys
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
# Machine-specific identity and signing key (untracked); keep this last
[include]
	path = ~/.config/git/local
